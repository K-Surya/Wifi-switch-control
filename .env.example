# Login credentials (choose these OR CREDENTIALS_FILE, never both).
APP_USERNAME=
APP_PASSWORD=

# For file-based credentials, comment out APP_USERNAME/APP_PASSWORD above and set:
# CREDENTIALS_FILE=./credentials.json

# MQTT broker reachable from this machine/container.
MQTT_URL=mqtt://<server_ip:port>

# Optional: omit both for an anonymous broker.
# MQTT_USERNAME=
# MQTT_PASSWORD=

# Health is online while a message has arrived within this many milliseconds.
HEALTH_ONLINE_TIMEOUT_MS=30000
PORT=3000
SESSION_STORE_FILE=data/sessions.json
TRUST_PROXY=false
